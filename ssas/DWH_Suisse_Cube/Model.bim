            "sourceColumn": "DayName",
            "summarizeBy": "none",
            "sortByColumn": "Jour de la semaine n°"
          },
          {
            "name": "Week-end",
            "dataType": "boolean",
            "sourceColumn": "IsWeekend",
            "summarizeBy": "none"
          },
          {
            "name": "Férié",
            "dataType": "boolean",
            "sourceColumn": "IsHoliday",
            "summarizeBy": "none"
          },
          {
            "name": "Nom du jour férié",
            "dataType": "string",
            "sourceColumn": "HolidayName",
            "summarizeBy": "none"
          },
          {
            "name": "Type de jour",
            "dataType": "string",
            "sourceColumn": "DayType",
            "summarizeBy": "none",
            "description": "Jour ouvrable / Samedi / Dimanche ou férié"
          }
        ],
        "partitions": [
          {
            "name": "Date",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": "SELECT * FROM cube.vw_Date",
              "dataSource": "CH_DWH"
            }
          }
        ],
        "dataCategory": "Time",
        "hierarchies": [
          {
            "name": "Calendrier",
            "levels": [
              {
                "name": "Année",
                "ordinal": 0,
                "column": "Année"
              },
              {
                "name": "Mois",
                "ordinal": 1,
                "column": "Mois"
              },
              {
                "name": "Date",
                "ordinal": 2,
                "column": "Date"
              }
            ]
          }
        ]
      },
