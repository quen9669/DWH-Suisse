        "measures": [
          {
            "name": "Température moyenne (°C)",
            "expression": "AVERAGE ( 'Météo'[Temperature] )",
            "formatString": "0.0",
            "displayFolder": "Météo",
            "description": "Température moyenne à 2 m."
          },
          {
            "name": "Précipitations (mm)",
            "expression": "SUM ( 'Météo'[Precipitation] )",
            "formatString": "#,0.0",
            "displayFolder": "Météo",
            "description": "Cumul de pluie (additionné sur les heures et cantons sélectionnés)."
          },
          {
            "name": "Neige (cm)",
            "expression": "SUM ( 'Météo'[Snowfall] )",
            "formatString": "#,0.0",
            "displayFolder": "Météo",
            "description": "Cumul de neige fraîche."
          },
          {
            "name": "Vent moyen (km/h)",
            "expression": "AVERAGE ( 'Météo'[WindSpeed] )",
            "formatString": "0.0",
