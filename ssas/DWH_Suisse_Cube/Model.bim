            "description": "Vitesse moyenne du vent à 10 m."
          },
          {
            "name": "Heures pluvieuses",
            "expression": "SUM ( 'Météo'[IsWetHour] )",
            "formatString": "#,0",
            "displayFolder": "Météo",
            "description": "Nombre d'heures x cantons avec au moins 0,5 mm de pluie ou de la neige."
          }
        ]
