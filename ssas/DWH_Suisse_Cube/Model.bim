{
  "name": "SemanticModel",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "fr-FR",
    "description": "DWH Suisse : ponctualité des transports publics suisses croisée avec la météo.",
    "dataSources": [
      {
        "name": "CH_DWH",
        "connectionString": "Provider=MSOLEDBSQL.1;Data Source=localhost;Initial Catalog=CH_DWH;Integrated Security=SSPI;Persist Security Info=False",
        "impersonationMode": "impersonateServiceAccount"
      }
    ],
    "tables": [
      {
        "name": "Date",
        "description": "Calendrier (jour d'exploitation des transports).",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy",
            "isKey": true
          },
          {
            "name": "Année",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Trimestre n°",
            "dataType": "int64",
            "sourceColumn": "Quarter",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Trimestre (tri)",
            "dataType": "int64",
            "sourceColumn": "YearQuarter",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Trimestre",
            "dataType": "string",
            "sourceColumn": "QuarterLabel",
            "summarizeBy": "none",
            "sortByColumn": "Trimestre (tri)"
          },
          {
            "name": "Mois n°",
            "dataType": "int64",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Mois",
            "dataType": "string",
            "sourceColumn": "MonthName",
            "summarizeBy": "none",
            "sortByColumn": "Mois n°"
          },
          {
            "name": "Année-Mois (tri)",
            "dataType": "int64",
            "sourceColumn": "YearMonth",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Année-Mois",
            "dataType": "string",
            "sourceColumn": "YearMonthLabel",
            "summarizeBy": "none",
            "sortByColumn": "Année-Mois (tri)"
          },
          {
            "name": "Semaine ISO",
            "dataType": "int64",
            "sourceColumn": "IsoWeek",
            "summarizeBy": "none"
          },
          {
            "name": "Jour du mois",
            "dataType": "int64",
            "sourceColumn": "DayOfMonth",
            "summarizeBy": "none"
          },
          {
            "name": "Jour de la semaine n°",
            "dataType": "int64",
            "sourceColumn": "DayOfWeek",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Jour de la semaine",
