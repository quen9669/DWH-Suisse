      {
        "name": "Passages",
        "description": "FAIT : un passage d'un trajet à un arrêt (horaire prévu vs réel).",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "TimeKey",
            "dataType": "int64",
            "sourceColumn": "TimeKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "HourKey",
            "dataType": "int64",
            "sourceColumn": "HourKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "StationKey",
            "dataType": "int64",
            "sourceColumn": "StationKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CantonKey",
            "dataType": "int64",
            "sourceColumn": "CantonKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "OperatorKey",
            "dataType": "int64",
            "sourceColumn": "OperatorKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "LineKey",
            "dataType": "int64",
            "sourceColumn": "LineKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "TransportModeKey",
            "dataType": "int64",
            "sourceColumn": "TransportModeKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ArrivalStatusKey",
            "dataType": "int64",
            "sourceColumn": "ArrivalStatusKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "DepartureStatusKey",
            "dataType": "int64",
            "sourceColumn": "DepartureStatusKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Trajet",
            "dataType": "string",
            "sourceColumn": "TripId",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Retard (min)",
            "dataType": "decimal",
            "sourceColumn": "DelayMinutes",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Retard positif (min)",
            "dataType": "decimal",
            "sourceColumn": "PositiveDelayMinutes",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Trajet supplémentaire",
            "dataType": "boolean",
            "sourceColumn": "IsAdditionalTrip",
            "summarizeBy": "none"
          },
          {
            "name": "Passage sans arrêt",
            "dataType": "boolean",
            "sourceColumn": "IsPassThrough",
            "summarizeBy": "none"
          },
          {
            "name": "StopCount",
            "dataType": "int64",
            "sourceColumn": "StopCount",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "CancelledCount",
            "dataType": "int64",
            "sourceColumn": "CancelledCount",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "MeasuredCount",
            "dataType": "int64",
            "sourceColumn": "MeasuredCount",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "PunctualCount",
            "dataType": "int64",
            "sourceColumn": "PunctualCount",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Passages",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": "SELECT * FROM cube.vw_Passage",
              "dataSource": "CH_DWH"
            }
          }
        ],
        "measures": [
          {
            "name": "Nb passages",
            "expression": "SUM ( 'Passages'[StopCount] )",
            "formatString": "#,0",
            "displayFolder": "1. Volumes",
            "description": "Nombre de passages planifiés (un trajet qui dessert un arrêt)."
          },
          {
            "name": "Nb trajets",
            "expression": "SUMX ( VALUES ( 'Date'[DateKey] ), CALCULATE ( DISTINCTCOUNT ( 'Passages'[Trajet] ) ) )",
            "formatString": "#,0",
            "displayFolder": "1. Volumes",
            "description": "Nombre de trajets distincts (un identifiant de trajet se répète chaque jour, d'où le calcul jour par jour)."
          },
          {
            "name": "Nb passages mesurés",
            "expression": "SUM ( 'Passages'[MeasuredCount] )",
            "formatString": "#,0",
            "displayFolder": "1. Volumes",
            "description": "Passages dont l'heure réelle est mesurée ou estimée (base des indicateurs de ponctualité)."
          },
          {
            "name": "Nb passages ponctuels",
            "expression": "SUM ( 'Passages'[PunctualCount] )",
            "formatString": "#,0",
            "displayFolder": "2. Ponctualité",
            "description": "Passages mesurés avec moins de 3 minutes de retard (définition CFF)."
          },
          {
            "name": "Taux de ponctualité",
            "expression": "DIVIDE ( [Nb passages ponctuels], [Nb passages mesurés] )",
            "formatString": "0.0 %",
            "displayFolder": "2. Ponctualité",
            "description": "Part des passages mesurés arrivés avec moins de 3 minutes de retard."
          },
          {
            "name": "Taux de ponctualité J-7",
            "expression": "CALCULATE ( [Taux de ponctualité], DATEADD ( 'Date'[Date], -7, DAY ) )",
            "formatString": "0.0 %",
            "displayFolder": "2. Ponctualité",
            "description": "Même indicateur une semaine plus tôt."
          },
          {
            "name": "Évolution ponctualité vs J-7",
            "expression": "IF ( NOT ISBLANK ( [Taux de ponctualité J-7] ), [Taux de ponctualité] - [Taux de ponctualité J-7] )",
            "formatString": "+0.0 %;-0.0 %;0.0 %",
            "displayFolder": "2. Ponctualité",
            "description": "Écart (en points) avec la semaine précédente."
          },
          {
            "name": "Retard moyen (min)",
            "expression": "AVERAGE ( 'Passages'[Retard (min)] )",
            "formatString": "0.00",
            "displayFolder": "3. Retards",
            "description": "Retard moyen des passages mesurés (une avance compte en négatif)."
          },
          {
            "name": "Retard max (min)",
            "expression": "MAX ( 'Passages'[Retard (min)] )",
            "formatString": "0.0",
            "displayFolder": "3. Retards",
            "description": "Plus gros retard mesuré."
          },
          {
            "name": "Retard cumulé (h)",
            "expression": "SUM ( 'Passages'[Retard positif (min)] ) / 60",
            "formatString": "#,0.0",
            "displayFolder": "3. Retards",
            "description": "Somme des retards (avances ignorées), en heures."
          },
          {
            "name": "Nb passages retard ≥ 5 min",
            "expression": "CALCULATE ( [Nb passages mesurés], 'Passages'[Retard (min)] >= 5 )",
            "formatString": "#,0",
            "displayFolder": "3. Retards",
            "description": "Passages mesurés avec au moins 5 minutes de retard."
          },
          {
            "name": "Nb suppressions",
            "expression": "SUM ( 'Passages'[CancelledCount] )",
            "formatString": "#,0",
            "displayFolder": "4. Suppressions",
            "description": "Passages supprimés (trajet annulé)."
          },
          {
            "name": "Taux de suppression",
            "expression": "DIVIDE ( [Nb suppressions], [Nb passages] )",
            "formatString": "0.00 %",
            "displayFolder": "4. Suppressions",
            "description": "Part des passages planifiés qui ont été supprimés."
          },
          {
            "name": "Taux de ponctualité - heures pluvieuses",
            "expression": "VAR HeuresPluie =\n    CALCULATETABLE (\n        SUMMARIZE ( 'Météo', 'Météo'[DateKey], 'Météo'[TimeKey], 'Météo'[CantonKey] ),\n        'Météo'[IsWetHour] = 1\n    )\nRETURN\n    CALCULATE (\n        [Taux de ponctualité],\n        TREATAS ( HeuresPluie, 'Passages'[DateKey], 'Passages'[HourKey], 'Passages'[CantonKey] )\n    )",
            "formatString": "0.0 %",
            "displayFolder": "5. Météo croisée",
            "description": "Ponctualité des passages ayant eu lieu pendant une heure de pluie/neige dans leur canton."
          },
          {
            "name": "Taux de ponctualité - heures sèches",
            "expression": "VAR HeuresSeches =\n    CALCULATETABLE (\n        SUMMARIZE ( 'Météo', 'Météo'[DateKey], 'Météo'[TimeKey], 'Météo'[CantonKey] ),\n        'Météo'[IsWetHour] = 0\n    )\nRETURN\n    CALCULATE (\n        [Taux de ponctualité],\n        TREATAS ( HeuresSeches, 'Passages'[DateKey], 'Passages'[HourKey], 'Passages'[CantonKey] )\n    )",
            "formatString": "0.0 %",
            "displayFolder": "5. Météo croisée",
            "description": "Ponctualité des passages ayant eu lieu pendant une heure sans précipitations dans leur canton."
          }
        ]
      },
      {
        "name": "Météo",
        "description": "FAIT : météo horaire au chef-lieu de chaque canton (Open-Meteo).",
        "columns": [
